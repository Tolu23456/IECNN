.venv/
__pycache__/
*.pyc
.pytest_cache/
.venv
*/.venv

# secrets — never commit
git.key
*.key
*_token*
.env

# data corpus is re-downloadable / generated, but code must be committed
data/*
!data/.gitkeep
!data/__init__.py
!data/dataset.py
!data/prepare.py

# training artifacts are rebuilt by runs
checkpoints/*
!checkpoints/.gitkeep
results/*.png
!results/.gitkeep

# spec is kept out of the public repo for now (per Tolu, 2026-11-01)
spec/
